{
  "name": "@phpforge/plugin-prettier",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --moduleResolution bundler --module esnext src/*.ts"
  },
  "dependencies": {
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "ignore": "7.0.14"
  },
  "devDependencies": {
    "rolldown": "1.2.15",
    "typescript": "5.9.3",
    "tsx": "^4.23.15",
    "@types/node": "^26.6.5"
  }
}
